# TUKOPAMOJA — production container build/run variables
# Copy to .env.container (or export in CI shell) before `docker compose -f docker-compose.server.yml up -d --build`

# Public app variables (embedded at build time)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_APP_URL=https://tukopamoja.yourdomain.com
NEXT_PUBLIC_MOBILE_SCHEME=tukopamoja

# Container/image controls
PORT=3000
IMAGE_NAME=ghcr.io/your-org/tukopamoja-web
IMAGE_TAG=latest
