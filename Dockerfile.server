# ╔══════════════════════════════════════════════════════════════╗
# ║  TUKOPAMOJA — Server-mode Dockerfile (next start)          ║
# ╚══════════════════════════════════════════════════════════════╝
#
# Builds Next.js as a standard server and runs with `next start`.
# No nginx or static hosting required — this is a full Node.js
# application server.
#
# Build:
#   docker build -f Dockerfile.server \
#     --build-arg NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co \
#     --build-arg NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... \
#     --build-arg NEXT_PUBLIC_APP_URL=https://yourdomain.com \
#     -t tukopamoja-web .
#
# Run:
#   docker run -p 3000:3000 tukopamoja-web

# ─── Stage 1: Install dependencies ──────────────────────────
FROM node:20-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json* ./
COPY packages/shared/package.json packages/shared/
COPY packages/web/package.json packages/web/
COPY packages/mobile/package.json packages/mobile/

RUN npm ci --ignore-scripts

# ─── Stage 1b: Production dependencies only ─────────────────
FROM node:20-alpine AS prod-deps

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json* ./
COPY packages/shared/package.json packages/shared/
COPY packages/web/package.json packages/web/
COPY packages/mobile/package.json packages/mobile/

RUN npm prune --omit=dev --workspaces --include-workspace-root

# ─── Stage 2: Build ─────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Build arguments
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_MOBILE_SCHEME=quizarena

ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_PUBLIC_MOBILE_SCHEME=${NEXT_PUBLIC_MOBILE_SCHEME}
ENV BUILD_MODE=server
ENV NEXT_TELEMETRY_DISABLED=1

# Copy deps (hoisted to root by npm workspaces)
COPY --from=deps /app/node_modules ./node_modules

# Copy source
COPY packages/shared/ packages/shared/
COPY packages/web/ packages/web/
COPY package.json ./

# Build for server mode (standard `next build`, no static export)
RUN npm run build:web

# ─── Stage 3: Production runner ─────────────────────────────
FROM node:20-alpine AS production

WORKDIR /app

# Add non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

ENV NODE_ENV=production
ENV BUILD_MODE=server
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Copy package files (needed for `next start`)
COPY --from=builder --chown=appuser:appgroup /app/package.json ./
COPY --from=builder --chown=appuser:appgroup /app/packages/web/package.json ./packages/web/
COPY --from=builder --chown=appuser:appgroup /app/packages/web/next.config.js ./packages/web/
COPY --from=builder --chown=appuser:appgroup /app/packages/shared/package.json ./packages/shared/

# Copy runtime dependencies only
COPY --from=prod-deps --chown=appuser:appgroup /app/node_modules ./node_modules

# Copy built application
COPY --from=builder --chown=appuser:appgroup /app/packages/web/.next ./packages/web/.next
COPY --from=builder --chown=appuser:appgroup /app/packages/web/public ./packages/web/public

# Copy shared package source (transpiled at runtime)
COPY --from=builder --chown=appuser:appgroup /app/packages/shared ./packages/shared

LABEL org.opencontainers.image.title="tukopamoja-web"
LABEL org.opencontainers.image.description="TUKOPAMOJA Next.js production server container"
LABEL org.opencontainers.image.source="https://github.com/Tarto-4/Tukopamoja"

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

EXPOSE 3000

# Graceful shutdown support
STOPSIGNAL SIGTERM

USER appuser

# Run from web package directory (where .next lives)
WORKDIR /app/packages/web

# Use node directly for faster startup and proper signal forwarding
CMD ["node", "../../node_modules/.bin/next", "start", "-p", "3000", "-H", "0.0.0.0"]
