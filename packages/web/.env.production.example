# ─────────────────────────────────────────────────────────────
# Tokupojomo Web — Production Environment
# Set these as GitHub repo secrets / environment variables
# or as CI env vars before building for deployment.
# ─────────────────────────────────────────────────────────────

# Supabase (cloud project)
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-production-anon-key>

# Public URL where the deployed app is accessible
NEXT_PUBLIC_APP_URL=https://<your-org>.github.io/quizarena

# Mobile deep-link scheme (must match Expo app.json)
NEXT_PUBLIC_MOBILE_SCHEME=quizarena
