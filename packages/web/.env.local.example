# ─────────────────────────────────────────────────────────────
# Tokupojomo Web — Local Development Environment
# Copy this file to .env.local and fill in real values.
# ─────────────────────────────────────────────────────────────

# Supabase (local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-local-anon-key>

# App URL — use your machine's LAN IP so other devices can reach you
# macOS:   ipconfig getifaddr en0
# Linux:   hostname -I
# Windows: ipconfig
NEXT_PUBLIC_APP_URL=http://192.168.x.x:3000

# Mobile deep-link scheme (must match Expo app.json scheme)
NEXT_PUBLIC_MOBILE_SCHEME=quizarena
