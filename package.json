{
  "name": "quizarena",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/web",
    "packages/mobile"
  ],
  "scripts": {
    "setup:env": "bash ./scripts/setup-local-env.sh",
    "dev:web": "npm -w packages/web run dev",
    "dev:mobile": "npm -w packages/mobile run start",
    "validate-env": "node scripts/validate-env.mjs",
    "validate-env:prod": "node scripts/validate-env.mjs --production",
    "build:web": "npm -w packages/web run build",
    "deploy:pages": "bash ./scripts/deploy-pages.sh",
    "build:shared": "npm -w packages/shared run build",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/shared/src/types/database.ts",
    "test:rules": "bash ./scripts/verify-game-rules.sh",
    "test:integration": "bash ./scripts/e2e-test.sh",
    "test:rls": "bash ./scripts/verify-rls.sh",
    "test:all": "npm run test:rules && npm run test:rls && npm run test:integration",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
